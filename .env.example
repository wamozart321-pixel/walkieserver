# Copia este archivo como .env y ajusta los valores.

PORT=3000

# --- Administrador ---
# Sirve como usuario normal y, si WEB_AUTH=true, para entrar a la web.
AUTH_USER=admin
AUTH_PASS=cambia-esta-clave-super-segura

# Protege TODA la web con una ventana de usuario/clave del navegador.
# Recomendado si el servidor es accesible desde internet.
WEB_AUTH=false

# --- Usuarios de la aplicacion ---
# Se crean al arrancar si no existen. Las claves se guardan cifradas (bcrypt)
# en data/app-users.json, asi que puedes borrarlas de aqui despues.
APP_USERS=ana:clave-ana,luis:clave-luis

# --- Registro desde la pantalla de acceso ---
# false = solo el administrador crea cuentas.
ALLOW_REGISTRATION=true
# Si lo rellenas, hara falta escribir este codigo para poder registrarse.
REGISTRATION_CODE=

# --- Red ---
# Origenes permitidos separados por comas. '*' acepta cualquiera.
ALLOWED_ORIGINS=*

# --- WebRTC ---
# Sin un servidor TURN, dos usuarios en redes distintas (datos moviles, oficinas
# con firewall) pueden no llegar a conectarse en directo. Si no hay TURN, la
# aplicacion sigue funcionando: el mensaje se envia al soltar el boton.
# Ejemplo: TURN_URL=turn:mi-servidor.com:3478
TURN_URL=
TURN_USER=
TURN_PASS=
