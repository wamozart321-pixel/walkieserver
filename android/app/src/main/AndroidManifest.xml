<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Servicio que mantiene la aplicación escuchando en segundo plano.
             El tipo "microphone" es obligatorio desde Android 14 para poder
             seguir capturando voz con la aplicación minimizada. -->
        <service
            android:name=".WalkieForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permisos -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Sin RECORD_AUDIO la aplicación no puede usar el micrófono: el
         walkie-talkie se quedaría mudo. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- WebRTC necesita conocer el estado de la red para negociar la conexión. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Servicio en primer plano: es lo que impide que Android suspenda la
         aplicación a los pocos minutos de minimizarla. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Desde Android 13 la notificación permanente del servicio requiere
         permiso; sin ella el sistema acaba matando el servicio. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- El micrófono es imprescindible, pero no se exige para poder instalar
         en equipos sin él (por ejemplo, algunas tabletas). -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
